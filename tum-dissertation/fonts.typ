// The dissertation the cover was measured from uses Latin Modern Sans and
// Nimbus Sans. New Computer Modern Sans and TeX Gyre Heros are the closest
// matches. They aren't built into Typst, which is why they're in `fonts/`.
#let _fonts = (
  serif: "New Computer Modern",
  sans: "New Computer Modern Sans",
  mono: "DejaVu Sans Mono",
  math: "New Computer Modern Math",
  cover-header: "TeX Gyre Heros",
)
